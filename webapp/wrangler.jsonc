// Cloudflare Workers 配置
// 首次部署前：
//   1. wrangler d1 create ai-image-studio        → 把返回的 database_id 填到下面
//   2. wrangler r2 bucket create ai-image-studio-images
//   3. npm run db:migrate
//   4. wrangler secret put AI_API_KEY            → 粘贴中转平台的令牌（sk-...）
// 本地开发：在 webapp/.dev.vars 里写一行 AI_API_KEY=sk-...（该文件已被 .gitignore 忽略）
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ai-image-studio",
    "main": "worker/index.ts",
    "compatibility_date": "2025-04-01",
    "assets": {
        "not_found_handling": "single-page-application"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ai-image-studio",
            "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
        }
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "ai-image-studio-images"
        }
    ],
    "vars": {
        // API 中转平台地址（Aiberm 等 OpenAI/Gemini 兼容中转）
        "AI_BASE_URL": "https://aiberm.com",
        // 关键词总结 / prompt 润色模型（名称以 Aiberm 模型页为准，注意 google/ 前缀）
        "TEXT_MODEL": "google/gemini-2.5-flash",
        // 生图模型（文生图和图生图同一个，$0.023/次）；
        // 想换更强的可改成 "gemini-3-pro-image-preview"（$0.055/次）
        "IMAGE_MODEL": "gemini-2.5-flash-image"
    }
}
