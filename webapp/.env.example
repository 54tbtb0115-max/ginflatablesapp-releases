# 复制为 .env 并填入真实值（.env 不会被提交到 git）

# ---------- 服务 ----------
# 监听端口；内网其他人通过 http://<服务器IP>:8787 访问
PORT=8787
# SQLite 数据库文件位置（会自动创建）
DB_PATH=data/app.db
# 自定义 DNS（逗号分隔）。仅当宿主机 DNS 解析不了外部 API 域名时才需要，
# 例如 Tailscale MagicDNS 接管了系统 DNS。留空则用系统默认。
#DNS_SERVERS=223.5.5.5,8.8.8.8
# HTTP(S) 代理。仅当宿主机无法直连 aiberm.com 等外部 API（被网络屏蔽）时才需要，
# 让所有请求走代理出去。留空则直连。
#HTTPS_PROXY=http://<代理IP>:<端口>

# ---------- AI（Aiberm 中转调 Gemini） ----------
AI_BASE_URL=https://aiberm.com
AI_API_KEY=sk-xxxxxxxxxxxxxxxx
TEXT_MODEL=google/gemini-2.5-flash
# 生图接口风格：gemini（默认）或 openai
#   - gemini：走 Gemini 原生接口，配合 gemini-*-image 模型
#   - openai：走 /v1/images 接口，配合 gpt-image 等模型，写实度更好（产品实拍类推荐）
#IMAGE_API=openai
# 生图模型。
#   gemini 接口：gemini-2.5-flash-image（快）/ gemini-3-pro-image-preview（更清晰）
#   openai 接口：gpt-image-1 / gpt-image-2 等（以 Aiberm 模型页名称为准）
IMAGE_MODEL=gemini-2.5-flash-image
# 输出尺寸。gemini 接口用 1K/2K/4K（仅 pro 系列支持）；
# openai 接口用 宽x高（如 1024x1024、1536x1024），或留空走 auto
#IMAGE_SIZE=2K
# 「高清重生成」按钮用的模型与分辨率（默认即下面两行，可不填）
#HD_IMAGE_MODEL=gemini-3-pro-image-preview
#HD_IMAGE_SIZE=2K

# ---------- 图片存储：Cloudflare R2（S3 兼容接口） ----------
# 不填这四项时自动退回本地磁盘存储（data/images/），方便离线调试
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
R2_BUCKET=genphotos
