# 复制为 .env 并填入真实值（.env 不会被提交到 git）

# ---------- 服务 ----------
# 监听端口；内网其他人通过 http://<服务器IP>:8787 访问
PORT=8787
# SQLite 数据库文件位置（会自动创建）
DB_PATH=data/app.db

# ---------- AI（Aiberm 中转调 Gemini） ----------
AI_BASE_URL=https://aiberm.com
AI_API_KEY=sk-xxxxxxxxxxxxxxxx
TEXT_MODEL=google/gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image

# ---------- 图片存储：Cloudflare R2（S3 兼容接口） ----------
# 不填这四项时自动退回本地磁盘存储（data/images/），方便离线调试
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
R2_BUCKET=genphotos
