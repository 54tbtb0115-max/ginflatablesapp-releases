{
    "private": true,
    "name": "ai-image-studio",
    "version": "0.2.0",
    "description": "聊天式 AI 生图网站（内网部署）：文生图 / 图生图，图片存 Cloudflare R2",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
        "build": "vite build",
        "start": "tsx server/index.ts",
        "user": "tsx server/manage-users.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.600.0",
        "@hono/node-server": "^1.13.0",
        "better-sqlite3": "11.0.0",
        "dotenv": "^16.4.5",
        "hono": "^4.6.0",
        "undici": "^6.21.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.26.0",
        "tsx": "^4.19.0"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "@types/better-sqlite3": "^7.6.11",
        "@types/node": "^22.0.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.19",
        "concurrently": "^9.0.0",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.4",
        "typescript": "^5.5.3",
        "vite": "^6.0.0"
    }
}
