{
    "private": true,
    "name": "ai-image-studio",
    "version": "0.1.0",
    "description": "聊天式 AI 生图网站：文生图 / 图生图，图片存 Cloudflare R2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
        "deploy": "npm run build && wrangler deploy",
        "db:migrate:local": "wrangler d1 execute ai-image-studio --local --file=./schema.sql",
        "db:migrate": "wrangler d1 execute ai-image-studio --remote --file=./schema.sql"
    },
    "dependencies": {
        "hono": "^4.6.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.26.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.0.0",
        "@cloudflare/workers-types": "^5.20260826.0",
        "@tailwindcss/forms": "^0.5.7",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.19",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.4",
        "typescript": "^5.5.3",
        "vite": "^6.0.0",
        "wrangler": "^4.0.0"
    }
}
